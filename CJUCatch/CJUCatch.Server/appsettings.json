{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "MaxHttpRequestBytes": 16384,
    "MaxHubMessageBytes": 16384,
    "AttemptWindowSeconds": 60,
    "CreateAttemptsPerWindow": 8,
    "JoinAttemptsPerWindow": 20
  },
  "AllowedHosts": "*"
}
