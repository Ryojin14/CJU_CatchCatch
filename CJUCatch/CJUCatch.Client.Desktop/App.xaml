<Application x:Class="CJUCatch.Client.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF3F5F9" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0033A0" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFE5EBF5" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF001E62" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF64758B" />
    </Application.Resources>
</Application>
