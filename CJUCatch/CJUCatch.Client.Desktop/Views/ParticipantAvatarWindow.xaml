<Window x:Class="CJUCatch.Client.Desktop.Views.ParticipantAvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        Width="117"
        Height="148">
    <Grid>
        <Border x:Name="SpeechBubbleBorder"
                Width="104"
                MinHeight="28"
                Margin="0,3,0,0"
                VerticalAlignment="Top"
                Padding="8,5"
                Background="#F7FFFDF8"
                BorderBrush="#FFE3E8DE"
                BorderThickness="1"
                CornerRadius="14"
                Visibility="Collapsed">
            <TextBlock x:Name="SpeechBubbleTextBlock"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="10"
                       Foreground="#FF1E2A25"
                       Text="..." />
        </Border>

        <Image x:Name="CharacterImage"
               Width="97"
               Height="97"
               Margin="10,22,10,0"
               VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Border VerticalAlignment="Bottom"
                Width="100"
                Height="20"
                CornerRadius="10"
                Background="#CC000000">
            <TextBlock x:Name="NameTextBlock"
                       Margin="8,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       Text="게스트"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
