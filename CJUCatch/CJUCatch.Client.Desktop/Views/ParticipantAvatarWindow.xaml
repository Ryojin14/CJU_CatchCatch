<Window x:Class="CJUCatch.Client.Desktop.Views.ParticipantAvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="148"
        Height="198">
    <Grid IsHitTestVisible="False">
        <Border x:Name="SpeechBubbleBorder"
                Width="132"
                MinHeight="36"
                Margin="0,4,0,0"
                VerticalAlignment="Top"
                Padding="10,8"
                Background="#F7FFFDF8"
                BorderBrush="#FFE3E8DE"
                BorderThickness="1"
                CornerRadius="18"
                Visibility="Collapsed">
            <TextBlock x:Name="SpeechBubbleTextBlock"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="11"
                       Foreground="#FF1E2A25"
                       Text="..." />
        </Border>

        <Ellipse Width="92"
                 Height="92"
                 Margin="0,42,0,0"
                 VerticalAlignment="Top"
                 Fill="#FF7BAF9B" />
        <Ellipse Width="68"
                 Height="46"
                 Margin="0,60,0,0"
                 VerticalAlignment="Top"
                 Fill="#FFF5FAF8" />
        <Ellipse Width="7"
                 Height="7"
                 Margin="0,80,18,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Fill="#FF1E2A25" />
        <Ellipse Width="7"
                 Height="7"
                 Margin="18,80,0,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Fill="#FF1E2A25" />
        <Ellipse Width="12"
                 Height="7"
                 Margin="0,94,0,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Fill="#FFD96557" />

        <Border VerticalAlignment="Bottom"
                Width="138"
                Height="36"
                CornerRadius="18"
                Background="#F2FFFCF5">
            <TextBlock x:Name="NameTextBlock"
                       Margin="12,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FF1E2A25"
                       Text="게스트"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
