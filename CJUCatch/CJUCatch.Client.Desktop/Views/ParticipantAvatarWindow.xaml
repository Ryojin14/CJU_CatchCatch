<Window x:Class="CJUCatch.Client.Desktop.Views.ParticipantAvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        Width="156"
        Height="212">
    <Grid>
        <Border x:Name="SpeechBubbleBorder"
                Width="138"
                MinHeight="38"
                Margin="0,4,0,0"
                VerticalAlignment="Top"
                Padding="12,8"
                Background="#F7FFFDF8"
                BorderBrush="#FFE3E8DE"
                BorderThickness="1"
                CornerRadius="18"
                Visibility="Collapsed">
            <TextBlock x:Name="SpeechBubbleTextBlock"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="11"
                       Foreground="#FF1E2A25"
                       Text="..." />
        </Border>

        <Image x:Name="CharacterImage"
               Width="130"
               Height="130"
               Margin="13,30,13,0"
               VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Border VerticalAlignment="Bottom"
                Width="138"
                Height="36"
                CornerRadius="18"
                Background="#F2FFFCF5">
            <TextBlock x:Name="NameTextBlock"
                       Margin="12,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FF1E2A25"
                       Text="게스트"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
