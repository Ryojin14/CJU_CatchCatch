<Window x:Class="CJUCatch.Client.Desktop.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="도움말"
        Width="420"
        Height="290"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7F3EA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#FF1E2A25"
                   Text="조작 방법" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="16"
                Background="#FFFFFCF5"
                CornerRadius="18">
            <TextBlock FontSize="14"
                       Foreground="#FF1E2A25"
                       TextWrapping="Wrap">
캐릭터를 클릭 후 드래그하면 위치가 이동합니다.

캐릭터를 우클릭하면 설정 메뉴가 열립니다.

캐릭터를 더블클릭하면 말풍선 입력창이 열립니다.
            </TextBlock>
        </Border>

        <Button Grid.Row="2"
                Width="88"
                Height="38"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                Background="#FF1E6B52"
                Foreground="White"
                BorderThickness="0"
                Click="CloseButton_Click"
                Content="닫기" />
    </Grid>
</Window>
